{
  "name": "broadcast-control-center-preview",
  "version": "0.4.0-alpha.1",
  "private": true,
  "description": "Broadcast Control Center · V107 Regie, Medien und Geräte",
  "license": "MIT",
  "type": "module",
  "main": "dist/launcher.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never",
    "assets": "python3 scripts/provision-content.py"
  },
  "dependencies": {
    "obs-websocket-js": "5.0.8",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "atem-connection": "3.10.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "44.4.1",
    "electron-builder": "26.16.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "ws": "8.21.3"
  },
  "build": {
    "appId": "org.broadcastcc.controlcenter.preview",
    "productName": "Broadcast Control Center Preview",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Verbindet OBS und eingerichtete Geräte im lokalen Netz zur ausdrücklich freigegebenen Senderegie."
      },
      "artifactName": "Broadcast-Control-Center-Preview-${version}-${arch}.${ext}"
    }
  }
}
